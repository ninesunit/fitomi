rules_version = '2';

// ---------------------------------------------------------------------------
// Fitomi security rules.
//
// Every document lives under /users/{uid}. A signed-in hunter can read and
// write their own subtree and nothing else. There is no server-side code in
// this app (Spark plan, no Cloud Functions), so these rules are the entire
// authorisation layer and are written to fail closed.
//
// IMPORTANT — no recursive `match /{document=**}` wildcard appears below, and
// none may be added. Firestore evaluates every matching rule and grants access
// if ANY of them allows it, so a permissive catch-all silently overrides every
// stricter rule beneath it: the workout integrity constraints here were dead
// code until that wildcard was removed. Collections are therefore enumerated
// explicitly. A new collection is denied until it is added here, which is the
// safe direction to fail in.
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Guard against a client writing a document large enough to be abusive.
    function sizeOk() {
      return request.resource.data.size() < 400;
    }

    // ---- XP integrity -----------------------------------------------------
    //
    // There is no server, so these rules cannot recompute a workout and check
    // the XP it should have paid. What they can do is bound every number a
    // client may write, which turns "set totalXp to a billion" into "grind
    // many writes over many days" — and makes the ceiling identical whether
    // the write comes through the app or through a console.
    //
    // The numbers mirror engine/integrity.js. A hard advanced session scores
    // about 3,000 and the theoretical maximum is about 13,200.

    function num(field, fallback) {
      return field in request.resource.data && request.resource.data[field] is number
        ? request.resource.data[field]
        : fallback;
    }

    function priorNum(field, fallback) {
      return resource != null && field in resource.data && resource.data[field] is number
        ? resource.data[field]
        : fallback;
    }

    // A single write may move XP by at most one whole day's allowance, in
    // either direction. Negative deltas are allowed because un-ticking a quest
    // legitimately returns XP.
    //
    // It is set to the daily ceiling rather than the per-session one because
    // profile saves are debounced: a hunter who trains and then clears the
    // quest board before the save fires legitimately lands a day's worth of XP
    // in one write, and rejecting that would lose their session.
    //
    // This bounds the size of a jump, not the rate of them. Rate limiting is
    // not attempted: any threshold loose enough to admit a real workout landing
    // seconds after the previous save is too loose to inconvenience a script.
    function xpDeltaOk() {
      return num('totalXp', 0) - priorNum('totalXp', 0) <= 20000
          && priorNum('totalXp', 0) - num('totalXp', 0) <= 20000;
    }

    // Absolute ceilings, so no single write can land an absurd value even if
    // the delta somehow passed.
    function xpBoundsOk() {
      return num('totalXp', 0) >= 0
          && num('totalXp', 0) <= 500000000
          && num('level', 1) >= 1
          && num('level', 1) <= 500;
    }

    // Level must be earnable from the XP on the same document. The cheapest
    // level in the curve costs 250 XP and every later one costs more, so
    // 250 * (level - 1) is a floor that no honest profile can fall below and
    // no forged level can satisfy.
    function levelMatchesXp() {
      return num('totalXp', 0) >= (num('level', 1) - 1) * 250;
    }

    function statsOk() {
      return !('stats' in request.resource.data)
          || (request.resource.data.stats is map && request.resource.data.stats.size() <= 16);
    }

    // The profile document: progression, stats, streak, shadows, records,
    // the active raid and the quest board.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow delete: if isOwner(uid);
      // A profile may only ever be stamped with its owner's uid, and its
      // progression numbers must stay inside the bounds above.
      allow create, update: if isOwner(uid)
                            && sizeOk()
                            && (!('uid' in request.resource.data) || request.resource.data.uid == uid)
                            && xpBoundsOk()
                            && levelMatchesXp()
                            && statsOk()
                            && (resource == null || xpDeltaOk());
    }

    // Finished sessions. Must carry the owner's uid and a real timestamp, so a
    // session can never be back-dated into someone else's history or written
    // without the field the history query orders by.
    match /users/{uid}/workouts/{workoutId} {
      allow read: if isOwner(uid);
      // Volume and XP are bounded to what the scorer can plausibly produce,
      // and a session cannot be stamped into the future or the deep past —
      // back-dating is how a leaderboard week gets stuffed.
      allow create: if isOwner(uid)
                    && sizeOk()
                    && request.resource.data.uid == uid
                    && request.resource.data.finishedAt is number
                    && request.resource.data.finishedAt <= request.time.toMillis() + 300000
                    && request.resource.data.finishedAt >= request.time.toMillis() - 604800000
                    && (!('xp' in request.resource.data)
                        || (request.resource.data.xp is number
                            && request.resource.data.xp >= 0
                            && request.resource.data.xp <= 12000))
                    && (!('volumeKg' in request.resource.data)
                        || (request.resource.data.volumeKg is number
                            && request.resource.data.volumeKg >= 0
                            && request.resource.data.volumeKg <= 500000));
      allow update: if isOwner(uid)
                    && sizeOk()
                    && request.resource.data.uid == uid;
      allow delete: if isOwner(uid);
    }

    // Saved routines, including programmes imported from Notomi.
    match /users/{uid}/routines/{routineId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
                            && sizeOk()
                            && request.resource.data.uid == uid;
      allow delete: if isOwner(uid);
    }

    // ---- SOCIAL ------------------------------------------------------------
    //
    // These are the only documents one hunter can read about another, so the
    // shape of them is the privacy boundary: a public card carries a name, a
    // rank, this week's tonnage and a short list of achievements, and nothing
    // else. Session contents, bodyweight and notes never leave /users/{uid}.
    //
    // Every number on a card is bounded the same way the private profile is,
    // because a leaderboard is exactly where an inflated number would be worth
    // having.

    function signedIn() {
      return request.auth != null;
    }

    function cardNumbersOk() {
      return num('level', 1) >= 1 && num('level', 1) <= 500
          && num('totalXp', 0) >= 0 && num('totalXp', 0) <= 500000000
          && num('totalXp', 0) >= (num('level', 1) - 1) * 250
          && num('streak', 0) >= 0 && num('streak', 0) <= 3650
          && num('weeklyVolumeKg', 0) >= 0 && num('weeklyVolumeKg', 0) <= 2000000
          && num('weeklySessions', 0) >= 0 && num('weeklySessions', 0) <= 100
          && num('workouts', 0) >= 0 && num('workouts', 0) <= 100000
          && num('prCount', 0) >= 0 && num('prCount', 0) <= 500000;
    }

    function eventsOk() {
      return !('recentEvents' in request.resource.data)
          || (request.resource.data.recentEvents is list
              && request.resource.data.recentEvents.size() <= 8);
    }

    // The public card. Readable by any signed-in hunter, writable only by its
    // owner — searching for a friend requires reading strangers' cards, which
    // is the whole point of the collection.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
                            && sizeOk()
                            && (!('uid' in request.resource.data) || request.resource.data.uid == uid)
                            && cardNumbersOk()
                            && eventsOk();
      allow delete: if isOwner(uid);
    }

    // Handle reservations. Create-once: a handle may be claimed by whoever
    // takes it first and re-asserted only by that same hunter, which is what
    // makes the uniqueness transaction in social.js meaningful.
    match /handles/{handle} {
      // `get` is open so the awakening can tell someone their chosen name is
      // taken *before* they have an account — there is no sign-in yet at that
      // point in the flow. `list` still requires auth, so a single name can be
      // checked but the roster cannot be enumerated.
      allow get: if true;
      allow list: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Friendships. Each side keeps its own list; a hunter may write into
    // another's list only to complete a friendship that was requested, which
    // is why acceptance writes both sides in one batch.
    match /users/{uid}/friends/{friendUid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) || isOwner(friendUid);
      allow delete: if isOwner(uid) || isOwner(friendUid);
      allow update: if false;
    }

    // Friend requests land in the target's inbox. The requester may create
    // exactly one document, keyed by their own uid, so nobody can flood an
    // inbox or forge a request from someone else.
    match /users/{uid}/friendRequests/{fromUid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(fromUid)
                    && request.resource.data.from == fromUid
                    && sizeOk();
      allow delete: if isOwner(uid) || isOwner(fromUid);
      allow update: if false;
    }

    // Guilds. The roster is a map on one document so a whole guild is a single
    // read; the rule below is what keeps that safe, by allowing a member to
    // touch only their own row.
    function onlyOwnMemberRow() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['members', 'memberUids'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys()
               .hasOnly([request.auth.uid]);
    }

    match /guilds/{guildId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.memberUids.size() == 1
                    && sizeOk();
      // Either the owner administering the guild, or a member updating only
      // their own row (joining, leaving, refreshing their tonnage).
      allow update: if signedIn()
                    && sizeOk()
                    && (resource.data.ownerUid == request.auth.uid || onlyOwnMemberRow());
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Parties are ephemeral and join-by-code. Anyone signed in who knows the
    // code may join, which is the point; only the host can tear one down.
    match /parties/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid && sizeOk();
      allow update: if signedIn() && sizeOk();
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
